# ---------------------------------------------------------------------------
# Production — a copier en `.env.prod` sur le VPS, puis a remplir.
# Ce fichier-ci est un modele : il ne doit JAMAIS contenir de vrai secret.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# ---------------------------------------------------------------------------

# --- Domaines --------------------------------------------------------------
# Trois enregistrements DNS de type A pointant vers l'IP du VPS Hostinger.
WEB_DOMAIN=athena.residence-leonie.com
API_DOMAIN=api.athena.residence-leonie.com
UPLOAD_DOMAIN=upload.athena.residence-leonie.com

# Fuseau horaire : pilote l'affichage des dates par PHP (agendas, rapports
# journaliers) et par le service d'upload.
TZ=Indian/Antananarivo

# --- MariaDB (conteneur `database`) ----------------------------------------
# Athena est sur MySQL/MariaDB, pas PostgreSQL : l'unique migration Doctrine
# est du SQL MySQL et n'est pas portable.
MYSQL_DATABASE=bdd_athena_symfony
MYSQL_USER=athena
MYSQL_PASSWORD=               # openssl rand -base64 32
MYSQL_ROOT_PASSWORD=          # openssl rand -base64 32

# Version annoncee a Doctrine, pour lui eviter une requete au demarrage. A
# garder alignee avec le tag de l'image `mariadb` dans compose.prod.yaml.
MARIADB_SERVER_VERSION=10.11.6-MariaDB

# --- Symfony ---------------------------------------------------------------
APP_SECRET=                   # openssl rand -hex 32
JWT_PASSPHRASE=               # openssl rand -hex 32

# CORS de l'API Symfony : expression reguliere des origines autorisees
# (nelmio_cors, origin_regex: true). Les antislashs sont ceux de la regex.
CORS_ALLOW_ORIGIN=^https://athena\.residence-leonie\.com$

# Le CORS du service d'upload est derive de WEB_DOMAIN dans compose.prod.yaml
# (liste d'origines, pas une regex) : rien a renseigner ici.
